# QuestShell — htpasswd placeholder
# Generate real entries: htpasswd -bnBC 14 "username" "password"
# Replace this file at /etc/nginx/htpasswd/terminalking.htpasswd
#
# DO NOT commit the real .htpasswd to version control.
#
# Example entry (password: "changeme"):
# admin:$2y$14$AaBbCcDdEeFfGgHhIiJjKkLlMmNnOoPpQqRrSsTtUuVvWwXxYyZz
